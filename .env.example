# =============================================================================
# CONFIGURACIÓN DEL AGENTE ARQUITECTÓNICO
# =============================================================================
# Copia este archivo a .env y configura según tu entorno.
# NUNCA hagas commit de .env con claves reales.

# =============================================================================
# PROVEEDOR LLM
# =============================================================================
# Opciones: groq (default, gratis, tu propia clave), ollama (local),
#           proxy (servidor demo de un tercero, sin clave propia),
#           claude (API de Anthropic, de pago), mock (tests)
LLM_PROVIDER=groq

# =============================================================================
# GROQ (Proveedor default - GRATIS, sin tarjeta de crédito)
# =============================================================================
# 1. Genera una clave gratis en https://console.groq.com (1 min, solo email)
# 2. Copia tu API key aquí
GROQ_API_KEY=gsk_...

# Modelos disponibles en Groq (verificado 2026-11-24, catálogo cambia):
#   - openai/gpt-oss-20b (default: rápido, buen seguimiento de formato JSON)
#   - openai/gpt-oss-120b (más grande, más lento)
#   - qwen/qwen3.8-27b (misma familia que el modelo usado con Ollama)
# Catálogo vigente: https://console.groq.com/docs/models
# LLM_GROQ_MODEL=openai/gpt-oss-20b

# =============================================================================
# OLLAMA (Proveedor local - requiere instalación)
# =============================================================================
# Host del servidor Ollama (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Modelo instalado en Ollama (default: qwen3:8b)
# LLM_OLLAMA_MODEL=qwen3:8b

# =============================================================================
# PROXY (modo demo - usa la clave de un tercero, sin crear cuenta propia)
# =============================================================================
# Pide la URL al operador del servidor demo (ver server/proxy_server.py).
# Sujeto al rate limit que imponga ese operador (ej: 10 peticiones/hora).
# Para uso ilimitado, prefiere tu propia clave con LLM_PROVIDER=groq.
# PROXY_URL=https://tu-servidor-demo.onrender.com
# PROXY_ACCESS_TOKEN=...  # solo si el operador exige un token

# =============================================================================
# CLAUDE (API de Anthropic - de pago)
# =============================================================================
# AVISO: implementado y probado con mocks, aún no con la API real.
# Una suscripción Claude Pro NO incluye saldo de API (se factura aparte).
# 1. Genera una clave en https://console.anthropic.com/settings/keys
# 2. Copia tu API key aquí y pon LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo (default: claude-opus-5-5). Debe ser un modelo Claude 5.x.
# LLM_CLAUDE_MODEL=claude-opus-5-5

# =============================================================================
# PROYECTOS GUARDADOS
# =============================================================================
# Desactivado por defecto. Con AUTOGUARDADO=1 la app guarda cada proyecto en
# la carpeta proyectos/ y los lista al inicio. Quien pueda abrir la app verá
# esa lista: actívalo solo en tu equipo.
# AUTOGUARDADO=1
# AGENTE_PROYECTOS_DIR=C:/ruta/a/mis/proyectos

# =============================================================================
# DEBUG
# =============================================================================
# DEBUG=true  # Muestra logs detallados
